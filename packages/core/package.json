{
  "name": "universal-memory-core",
  "version": "0.7.0-beta.0",
  "description": "Universal memory system - Cross-project, cross-CLI, 100% local & private | 通用记忆系统 - 跨项目、跨CLI、100%本地私有",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chokidar": "^5.0.0",
    "p-retry": "^7.1.1",
    "sqlite-vec": "0.1.7-alpha.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/chokidar": "^1.7.5",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "memory",
    "ai",
    "mcp",
    "context"
  ],
  "author": "slicenferqin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slicenferqin/universal-memory-mcp.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/slicenferqin/universal-memory-mcp#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
