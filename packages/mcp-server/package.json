{
  "name": "universal-memory-mcp",
  "version": "0.6.0-beta.0",
  "description": "Super personal assistant for any AI CLI - Universal, cross-project, 100% local | 超级个人助理 - 通用、跨项目、100%本地",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "universal-memory-mcp": "./dist/index.js",
    "universal-memory-record": "./dist/record.js",
    "universal-memory-consolidate": "./dist/consolidate.js",
    "universal-memory-cron": "./dist/cron.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "vitest",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "universal-memory-core": "^0.6.0-beta.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "claude",
    "context",
    "model-context-protocol"
  ],
  "author": "slicenferqin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slicenferqin/universal-memory-mcp.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/slicenferqin/universal-memory-mcp#readme",
  "files": [
    "dist",
    "scripts",
    "README.md"
  ]
